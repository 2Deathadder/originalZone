rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function merchant() { return signedIn() && request.auth.token.role == 'merchant'; }
    function owner(userId) { return signedIn() && request.auth.uid == userId; }

    match /products/{id} {
      allow read: if resource.data.active == true || merchant();
      allow create, update, delete: if merchant();
    }
    match /categories/{id} {
      allow read: if true;
      allow write: if merchant();
    }
    match /users/{id} {
      allow read, update: if owner(id) || merchant();
      allow create: if signedIn() && request.auth.uid == id;
    }
    match /carts/{id} {
      allow read, write: if signedIn() && resource.data.userId == request.auth.uid;
    }
    match /orders/{id} {
      allow read: if merchant() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if merchant();
    }
    match /reviews/{id} {
      allow read: if resource.data.status == 'published' || merchant();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if merchant() || (signedIn() && resource.data.userId == request.auth.uid);
    }
    match /promotions/{id} { allow read: if true; allow write: if merchant(); }
    match /auditLogs/{id} { allow read, write: if merchant(); }
  }
}
